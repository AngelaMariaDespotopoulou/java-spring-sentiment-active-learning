# =============================================================================
# .env.local.template — Template for local build environment
# sentiment-active-learning
#
# Used with: docker-compose.local.yml
#
# HOW TO USE:
#   1. Copy this file to .env.local in the project root:
#        cp .env.local.template .env.local
#   2. Fill in every value marked  ← REQUIRED
#   3. Review and adjust every value marked  ← REVIEW
#   4. Never commit .env.local to Git — it is already listed in .gitignore
#
# This template IS committed to Git. It documents the required configuration
# without containing any real secrets.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Port exposed on the host machine. Change if 8080 is already in use.
# The same value is used for both the host binding and inside the container.
#   ← REVIEW
APP_PORT=8080

# Spring profile activated inside the container.
# 'prod' activates application-prod.properties if present,
# otherwise falls back to application.properties defaults.
# Do not set this to 'dev' in Docker — the dev profile uses H2 in-memory
# and hardcoded paths that are incompatible with the container environment.
#   ← REVIEW
SPRING_PROFILES_ACTIVE=prod


# =============================================================================
# SWAGGER UI — HTTP BASIC AUTH
# =============================================================================

# Username for the Swagger UI Basic Auth prompt.
#   ← REVIEW
SWAGGER_USERNAME=admin

# Password for the Swagger UI Basic Auth prompt.
# Use a strong value — this is your only protection for the API in Docker.
#   ← REQUIRED — change from the placeholder below
SWAGGER_PASSWORD=replace_with_a_strong_password


# =============================================================================
# CLAUDE AI ORACLE
# =============================================================================

# Your Anthropic API key.
# Obtain one at: https://console.anthropic.com/
# Format:        sk-ant-api03-...
# Cost note:     Claude is only called when the classifier is uncertain
#                (confidence < uncertainty-threshold, default 0.65).
#                Low-volume local testing incurs minimal cost.
#   ← REQUIRED — paste your real key below
CLAUDE_API_KEY=sk-ant-api03-replace-with-your-real-key


# =============================================================================
# ACTIVE LEARNING — MODEL PERSISTENCE
# =============================================================================

# Absolute path INSIDE the container where the trained Tribuo model is saved
# and loaded from. This path must be inside the Docker volume mount point
# (/app/model/) — do not change it unless you also update the volume
# configuration in docker-compose.local.yml.
#   ← REVIEW — only change if you modify the volume mount path
MODEL_STORAGE_PATH=/app/model/sentiment-model.ser

# Number of new labelled samples added since the model was last saved that
# cause the model to be considered stale at startup.
# When stale, the application retrains from the full database rather than
# loading the saved file. Lower values retrain more aggressively.
# Recommended range: 5–20.
#   ← REVIEW
MODEL_STALENESS_THRESHOLD=5
