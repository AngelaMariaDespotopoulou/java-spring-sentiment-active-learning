# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# =============================================================================
# DOCKER
# =============================================================================
.docker/

# docker-compose override files with local environment specifics
docker-compose.override.yml


# =============================================================================
# ML MODEL — NEVER COMMIT TRAINED MODEL FILES
# =============================================================================

# Serialised Tribuo model files produced by TrainingService.
# These are runtime artefacts, not source code. They can be large and must
# be stored on a bind-mounted Docker volume instead.
model/
*.ser

# Keep the model directory itself trackable via a .gitkeep placeholder,
# but ignore everything inside it.
!model/.gitkeep


# =============================================================================
# MISC
# =============================================================================
*.orig
*.rej
HELP.md