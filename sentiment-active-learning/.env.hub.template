# =============================================================================
# .env.hub.template — Template for DockerHub pull environment
# sentiment-active-learning
#
# Used with: docker-compose.hub.yml
#
# HOW TO USE:
#   1. Copy this file to .env.hub in the project root:
#        cp .env.hub.template .env.hub
#   2. Fill in every value marked  ← REQUIRED
#   3. Review and adjust every value marked  ← REVIEW
#   4. Never commit .env.hub to Git — it is already listed in .gitignore
#
# BEFORE USING THIS FILE — publish the image to DockerHub first:
#   docker build -t amdespotopoulou/sentiment-active-learning:1.0.0 .
#   docker login
#   docker push amdespotopoulou/sentiment-active-learning:1.0.0
#
# This template IS committed to Git. It documents the required configuration
# without containing any real secrets.
# =============================================================================


# =============================================================================
# DOCKERHUB IMAGE
# =============================================================================

# Your DockerHub account username.
# The image pulled will be:
#   ${DOCKERHUB_USERNAME}/sentiment-active-learning:${IMAGE_TAG}
# e.g.:
#   amdespotopoulou/sentiment-active-learning:1.0.0
#
# DockerHub profile: https://hub.docker.com/u/amdespotopoulou
#   ← REVIEW — set to your DockerHub username
DOCKERHUB_USERNAME=amdespotopoulou

# The image tag to pull and run.
# Use a specific version tag (e.g. 1.0.0) for reproducible, stable deploys.
# Use 'latest' to always pull the most recently pushed image — convenient
# but less predictable in production environments.
#   ← REQUIRED — set to the tag you have published
IMAGE_TAG=1.0.0


# =============================================================================
# APPLICATION
# =============================================================================

# Port exposed on the host machine.
#   ← REVIEW
APP_PORT=8080

# Spring profile activated inside the container.
# Keep as 'prod' unless you have a custom profile configured.
#   ← REVIEW
SPRING_PROFILES_ACTIVE=prod


# =============================================================================
# SWAGGER UI — HTTP BASIC AUTH
# =============================================================================

# Username for the Swagger UI Basic Auth prompt.
#   ← REVIEW
SWAGGER_USERNAME=admin

# Password for the Swagger UI Basic Auth prompt.
# Use a strong value — this is your only protection for the API.
#   ← REQUIRED — change from the placeholder below
SWAGGER_PASSWORD=replace_with_a_strong_password


# =============================================================================
# CLAUDE AI ORACLE
# =============================================================================

# Your Anthropic API key.
# Obtain one at: https://console.anthropic.com/
# Format:        sk-ant-api03-...
# Cost note:     Claude is only called when the classifier is uncertain
#                (confidence < uncertainty-threshold, default 0.65).
#   ← REQUIRED — paste your real key below
CLAUDE_API_KEY=sk-ant-api03-replace-with-your-real-key


# =============================================================================
# ACTIVE LEARNING — MODEL PERSISTENCE
# =============================================================================

# Absolute path INSIDE the container where the trained Tribuo model is saved
# and loaded from. Must be inside the Docker volume mount point (/app/model/).
# Do not change unless you also update the volume mount in docker-compose.hub.yml.
#   ← REVIEW — only change if you modify the volume mount path
MODEL_STORAGE_PATH=/app/model/sentiment-model.ser

# Number of new labelled samples added since the model was last saved that
# cause the model to be considered stale at startup.
# When stale, the application retrains from the full database rather than
# loading the saved file.
# Recommended range: 5–20.
#   ← REVIEW
MODEL_STALENESS_THRESHOLD=5
